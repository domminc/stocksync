# 서버
PORT=3000
HOST=127.0.0.1
# 운영(HTTPS) 환경에서는 1
SECURE_COOKIE=0
# 리버스 프록시(nginx 등) 뒤에서 실행하면 1
TRUST_PROXY=0
DB_PATH=data/stocksync.db
# 비밀번호 최소 길이 (기본 10, 설정 가능 범위 6~64). 짧을수록 추측하기 쉬우니 공개 서버에서는 기본값 이상을 권장
# PASSWORD_MIN_LENGTH=10
# 처음 실행할 때 사용자가 없으면 이 값으로 관리자 계정을 만든다. 계정이 만들어진 뒤에는 ADMIN_PASSWORD 줄을 지우세요.
# 이 파일(.env.example)에는 실제 비밀번호를 쓰지 말고, 서버의 .env 또는 서비스 설정에만 넣으세요.
ADMIN_USERNAME=jiny
ADMIN_PASSWORD=
# 1이면 13자리 바코드의 EAN-13 체크디지트가 틀린 행을 가져오기에서 거부한다 (기본: 경고만)
BARCODE_STRICT=0
