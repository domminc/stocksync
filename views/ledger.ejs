<%- include('partials/head') %>
<header class="page-head"><div><h1>재고 원장</h1><p class="lead">모든 재고 변동의 기록입니다. 수정하거나 삭제할 수 없습니다.</p></div></header>
<form method="get" action="/ledger" class="toolbar">
  <div class="grow"><label for="q">상품 (바코드 또는 상품코드)</label><input id="q" name="q" type="text" value="<%= q %>"></div>
  <div class="field">
    <label for="event">구분</label>
    <select id="event" name="event">
      <option value="">전체</option>
      <% Object.keys(EVENT_LABEL).forEach(function (k) { %><option value="<%= k %>"<%= k === event ? ' selected' : '' %>><%= EVENT_LABEL[k] %></option><% }) %>
    </select>
  </div>
  <div class="fit"><button class="pri" type="submit"><svg class="ic" aria-hidden="true"><use href="#i-search"/></svg>조회</button></div>
</form>
<% if (!result.rows.length) { %><p class="muted">조건에 맞는 기록이 없습니다.</p><% } else { %>
<div class="table-wrap"><table class="stack">
  <tr class="thead"><th>시각</th><th>구분</th><th>상품</th><th class="num">증감</th><th class="num">변동 후</th><th>메모</th><th>처리자</th></tr>
  <% result.rows.forEach(function (l) { %>
  <tr>
    <td class="small" data-label="시각"><%= fmtTime(l.created_at) %></td>
    <td data-label="구분"><%= EVENT_LABEL[l.event_type] || l.event_type %></td>
    <td class="title"><a href="/products/<%= l.product_id %>"><%= l.name %></a><% if (l.option_name) { %> <span class="muted small"><%= l.option_name %></span><% } %></td>
    <td class="num" data-label="증감"><%= (l.qty_delta > 0 ? '+' : '') + l.qty_delta %><% if (l.hold_delta) { %> <span class="muted small">(보류 <%= (l.hold_delta > 0 ? '+' : '') + l.hold_delta %>)</span><% } %></td>
    <td class="num" data-label="변동 후"><%= n(l.qty_after) %></td>
    <td class="small" data-label="메모"><%= l.reason %></td>
    <td class="small" data-label="처리자"><%= l.user_name || '-' %></td>
  </tr>
  <% }) %>
</table></div>
<% } %>
<%- include('partials/pager') %>
<%- include('partials/foot') %>
