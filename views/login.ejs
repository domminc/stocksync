<%- include('partials/head') %>
<div class="card">
  <div class="logo auth-logo" aria-hidden="true"><svg class="ic" viewBox="0 0 24 24"><path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2M7 8v8M11 8v8M15 8v8M18 8v8"/></svg></div>
  <h1>StockSync</h1>
  <p class="muted">매장·온라인 통합 재고관리</p>
  <% if (error) { %><div class="flash err" role="alert"><%= error %></div><% } %>
  <form method="post" action="/login" autocomplete="on">
    <input type="hidden" name="next" value="<%= next %>">
    <label for="username">아이디</label>
    <input id="username" name="username" type="text" autocomplete="username" autocapitalize="none" required autofocus>
    <label for="password">비밀번호</label>
    <input id="password" name="password" type="password" autocomplete="current-password" required>
    <p class="mt16"><button class="pri w100" type="submit">로그인</button></p>
  </form>
</div>
<%- include('partials/foot') %>
