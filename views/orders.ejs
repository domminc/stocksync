<%- include('partials/head') %>
<div class="row ac mb8">
  <div><h1>온라인 주문</h1><p class="muted">주문 접수만으로는 재고가 줄지 않습니다. “출고확정”에서 차감됩니다.</p></div>
  <div class="fit actions">
    <% if (can('order.import')) { %><a class="btn pri" href="/orders/import">주문 가져오기</a><% } %>
    <% if (can('order.ship')) { %><a class="btn" href="/orders/ship">출고 스캔</a><% } %>
  </div>
</div>

<form method="get" action="/orders" class="card">
  <div class="row">
    <div class="f2"><label for="q">검색 (주문번호 · 바코드 · 상품명)</label><input id="q" name="q" type="search" value="<%= q %>"></div>
    <div>
      <label for="status">상태</label>
      <select id="status" name="status">
        <% Object.keys(FILTERS).forEach(function (k) { %><option value="<%= k %>"<%= k === status ? ' selected' : '' %>><%= FILTERS[k] %></option><% }) %>
      </select>
    </div>
    <div class="fit"><button class="pri" type="submit">검색</button></div>
  </div>
</form>

<% if (!result.rows.length) { %><p class="muted">조건에 맞는 주문이 없습니다.</p><% } else { %>
<div class="table-wrap"><table>
  <tr><th>주문번호</th><th>쇼핑몰</th><th>상품</th><th class="num">수량</th><th class="num">재고</th><th>상태</th><th></th></tr>
  <% result.rows.forEach(function (o) {
       var short = o.status === 'pending' && o.product_id && o.qty > o.stock_qty; %>
  <tr<%= short ? ' class=risk' : '' %>>
    <td><%= o.order_no %><div class="small muted"><%= o.ordered_at %></div></td>
    <td><%= o.channel || '-' %></td>
    <td>
      <% if (o.product_id) { %><a href="/products/<%= o.product_id %>"><%= o.product_name %></a><% if (o.option_name) { %> <span class="muted small"><%= o.option_name %></span><% } %>
      <% } else { %><span class="chip low">미매칭</span> <%= o.item_name || o.raw_code %><div class="small muted"><%= o.raw_code %></div><% } %>
    </td>
    <td class="num"><%= o.qty %></td>
    <td class="num"><%= o.product_id ? n(o.stock_qty) : '-' %><% if (short) { %><div><span class="chip err">재고 부족</span></div><% } %></td>
    <td><span class="chip <%= o.status === 'pending' ? 'pri' : (o.status === 'canceled' ? '' : 'ok') %>"><%= ORDER_STATUS_LABEL[o.status] %></span>
      <% if (o.needs_return) { %><div><span class="chip err">반품 필요</span></div><% } %></td>
    <td>
      <div class="actions">
      <% if (o.status === 'pending' && can('order.ship')) { %>
        <% if (o.product_id) { %>
        <form method="post" action="/orders/<%= o.id %>/ship" class="inline" data-confirm="출고확정하면 재고가 <%= o.qty %>개 차감됩니다.">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="return_to" value="<%= returnTo %>">
          <button class="small pri" type="submit">출고확정</button></form>
        <% } else if (can('order.match')) { %><a class="btn small" href="/orders/unmatched">상품 연결</a><% } %>
        <form method="post" action="/orders/<%= o.id %>/cancel" class="inline" data-confirm="이 주문을 취소 처리합니다. 재고는 바뀌지 않습니다.">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="return_to" value="<%= returnTo %>">
          <button class="small danger" type="submit">취소</button></form>
      <% } %>
      <% if (o.status === 'shipped' && can('order.return')) { %>
        <form method="post" action="/orders/<%= o.id %>/return" class="inline" data-confirm="반품 입고(양품)로 판매 가능 재고에 <%= o.qty %>개 추가합니다.">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="return_to" value="<%= returnTo %>"><input type="hidden" name="condition" value="good">
          <button class="small" type="submit">반품(양품)</button></form>
        <form method="post" action="/orders/<%= o.id %>/return" class="inline" data-confirm="반품 입고(불량)로 보류 재고에 <%= o.qty %>개 추가합니다.">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="return_to" value="<%= returnTo %>"><input type="hidden" name="condition" value="bad">
          <button class="small danger" type="submit">반품(불량)</button></form>
      <% } %>
      </div>
    </td>
  </tr>
  <% }) %>
</table></div>
<% } %>
<%- include('partials/pager') %>
<%- include('partials/foot') %>
