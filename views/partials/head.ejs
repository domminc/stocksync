<!doctype html>
<html lang="ko"<% if (theme) { %> data-theme="<%= theme %>"<% } %>>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#4f46e5">
<title><%= title ? title + ' · ' : '' %>StockSync</title>
<link rel="icon" href="data:,">
<link rel="stylesheet" href="/static/style.css?v=<%= assetV %>">
<script src="/static/app.js?v=<%= assetV %>" defer></script>
</head>
<body<% if (user) { %> data-ps="<%= pageSize %>"<% } %><% if (msg) { %> data-beep="<%= msgType === 'err' ? 'err' : 'ok' %>"<% } %>>
<% if (user) { %>
<%- include('icons') %>
<div class="shell">
  <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="메뉴 열기/닫기">
  <aside class="side" id="side-nav">
    <a class="brand" href="/" aria-label="StockSync 대시보드로 이동"><span class="logo" aria-hidden="true"><svg class="ic"><use href="#i-scan"/></svg></span><span><span class="brand-name">StockSync</span><span class="brand-sub">통합 재고관리</span></span></a>
    <nav class="side-nav" aria-label="주 메뉴">
    <% nav.forEach(function (g) { %>
      <div class="nav-group"><%= g.group %></div>
      <% g.items.forEach(function (i) { %>
        <a href="<%= i.href %>"<% if (i.active) { %> class="active" aria-current="page"<% } %>><svg class="ic" aria-hidden="true"><use href="#i-<%= i.icon %>"/></svg><%= i.label %></a>
      <% }) %>
    <% }) %>
    </nav>
    <div class="side-user">
      <div class="who"><span class="avatar" aria-hidden="true"><%= user.displayName.slice(0, 1) %></span><span><strong><%= user.displayName %></strong><span class="role"><%= ROLES[user.role] %></span></span></div>
      <div class="theme-row"><span class="small muted">화면 테마</span><%- include('theme') %></div>
      <a href="/password"><svg class="ic" aria-hidden="true"><use href="#i-key"/></svg>비밀번호 변경</a>
      <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="ghost" type="submit"><svg class="ic" aria-hidden="true"><use href="#i-logout"/></svg>로그아웃</button></form>
    </div>
  </aside>
  <label for="nav-toggle" class="scrim" aria-hidden="true"></label>
  <div class="main-wrap">
    <header class="topbar">
      <label for="nav-toggle" class="menu-btn" aria-label="메뉴"><svg class="ic" aria-hidden="true"><use href="#i-menu"/></svg><span class="menu-text">메뉴</span></label>
      <a class="mbrand" href="/" aria-label="StockSync 대시보드로 이동">StockSync</a>
      <span class="spacer"></span>
      <details class="usermenu userinfo">
        <summary><span class="avatar" aria-hidden="true"><%= user.displayName.slice(0, 1) %></span><span class="uname"><strong><%= user.displayName %></strong><span class="role"><%= ROLES[user.role] %></span></span><svg class="ic sm" aria-hidden="true"><use href="#i-chev"/></svg></summary>
        <div class="menu-pop">
          <div class="theme-row"><span class="small muted">화면 테마</span><%- include('theme') %></div>
          <a href="/password"><svg class="ic" aria-hidden="true"><use href="#i-key"/></svg>비밀번호 변경</a>
          <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="ghost" type="submit"><svg class="ic" aria-hidden="true"><use href="#i-logout"/></svg>로그아웃</button></form>
        </div>
      </details>
    </header>
    <main class="main">
<% } else { %>
<main class="auth">
<% } %>
<% if (msg) { %><div class="flash <%= msgType %>" role="status"><%= msg %></div><% } %>
