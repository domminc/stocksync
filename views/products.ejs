<%- include('partials/head') %>
<div class="row ac mb8">
  <div><h1>상품·재고</h1></div>
  <div class="fit actions">
    <a class="btn" href="/products/export.csv">CSV 내려받기</a>
    <% if (can('label.print')) { %><a class="btn" href="/labels?<%= new URLSearchParams({ q: q, filter: filter }) %>">라벨 인쇄 (검색 결과)</a><% } %>
    <% if (can('product.import')) { %><a class="btn" href="/products/import">상품 가져오기</a><% } %>
    <% if (can('product.write')) { %><a class="btn pri" href="/products/new">+ 상품 등록</a><% } %>
  </div>
</div>

<form method="get" action="/products" class="card">
  <div class="row">
    <div class="f3">
      <label for="q">검색 (바코드 · 상품코드 · 상품명)</label>
      <input id="q" name="q" type="search" value="<%= q %>" placeholder="스캐너로 바코드를 읽거나 이름을 입력" autofocus>
    </div>
    <div>
      <label for="filter">보기</label>
      <select id="filter" name="filter">
        <% Object.keys(FILTERS).forEach(function (k) { %><option value="<%= k %>"<%= k === filter ? ' selected' : '' %>><%= FILTERS[k] %></option><% }) %>
      </select>
    </div>
    <div class="fit"><button class="pri" type="submit">검색</button></div>
  </div>
</form>

<% if (result.rows.length === 0) { %>
  <p class="muted">조건에 맞는 상품이 없습니다.</p>
<% } else { %>
<div class="table-wrap"><table class="stack">
  <tr class="thead">
    <th>상품</th><th>바코드</th><th class="num">판매 가능</th><th class="num">보류</th><th class="num">미출고 주문</th><th class="num">안전재고</th><th>상태</th>
  </tr>
  <% result.rows.forEach(function (r) {
       var st = stockStatus({ tracked: r.tracked, qty: r.qty, safety: r.safety_stock });
       var risk = r.tracked && r.pending > r.qty; %>
  <tr<%= risk ? ' class=risk' : '' %>>
    <td class="title"><a href="/products/<%= r.id %>"><%= r.name %></a>
      <% if (r.option_name) { %><div class="small muted"><%= r.option_name %></div><% } %>
      <% if (!r.active) { %><span class="chip">사용 중지</span><% } %></td>
    <td class="small" data-label="바코드"><%= r.barcode %><div class="muted"><%= r.sku_code !== r.barcode ? r.sku_code : '' %></div><% if (!r.label_printed_at && r.active) { %><span class="chip">라벨 미출력</span><% } %></td>
    <td class="num" data-label="판매 가능"><strong><%= n(r.qty) %></strong></td>
    <td class="num" data-label="보류"><%= r.hold ? n(r.hold) : '-' %></td>
    <td class="num" data-label="미출고 주문"><%= r.pending ? n(r.pending) : '-' %><% if (risk) { %><div><span class="chip err">가용 초과</span></div><% } %></td>
    <td class="num" data-label="안전재고"><%= r.safety_stock || '-' %></td>
    <td data-label="상태"><span class="chip <%= st === 'untracked' ? '' : st %>"><%= STATUS_LABEL[st] %></span></td>
  </tr>
  <% }) %>
</table></div>
<% } %>
<%- include('partials/pager') %>
<%- include('partials/foot') %>
