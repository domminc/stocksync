<%- include('partials/head') %>
<header class="page-head">
  <div><h1>상품·재고</h1><p class="lead">바코드를 스캔하거나 이름으로 검색하세요.</p></div>
  <div class="actions">
    <a class="btn" href="/products/export.csv">CSV 내려받기</a>
    <% if (can('label.print')) { %><a class="btn" href="/labels?<%= new URLSearchParams({ q: q, filter: filter }) %>">라벨 인쇄 (검색 결과)</a><% } %>
    <% if (can('product.import')) { %><a class="btn" href="/products/import">상품 가져오기</a><% } %>
    <% if (can('product.write')) { %><a class="btn pri" href="/products/new"><svg class="ic" aria-hidden="true"><use href="#i-plus"/></svg>상품 등록</a><% } %>
  </div>
</header>

<form method="get" action="/products" class="toolbar">
  <div class="grow">
    <label for="q">검색 (바코드 · 상품코드 · 상품명)</label>
    <input id="q" name="q" type="search" value="<%= q %>" placeholder="스캐너로 바코드를 읽거나 이름을 입력" autofocus>
  </div>
  <div class="field">
    <label for="filter">보기</label>
    <select id="filter" name="filter">
      <% Object.keys(FILTERS).forEach(function (k) { %><option value="<%= k %>"<%= k === filter ? ' selected' : '' %>><%= FILTERS[k] %></option><% }) %>
    </select>
  </div>
  <div class="fit"><button class="pri" type="submit"><svg class="ic" aria-hidden="true"><use href="#i-search"/></svg>검색</button></div>
</form>

<% if (can('product.write') && result.total > 0) { %>
<details class="card bulk-safety">
  <summary><strong>안전재고 일괄 설정</strong> <span class="small muted">— 지금 검색·보기 조건의 상품 <%= n(result.total) %>개에 한 번에 적용</span></summary>
  <form method="post" action="/products/safety-bulk" class="row ac mt12" data-confirm="<%= q || filter ? '현재 조건에 맞는 ' : '전체 ' %>상품 <%= n(result.total) %>개의 안전재고를 바꿉니다. 계속할까요?">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="q" value="<%= q %>"><input type="hidden" name="filter" value="<%= filter %>">
    <div class="minw160"><label for="bulk-safety">안전재고 (개)</label><input id="bulk-safety" name="safety_stock" type="number" min="0" max="1000000" inputmode="numeric" required placeholder="예: 5"></div>
    <div class="fit"><button class="pri" type="submit">적용</button></div>
  </form>
  <p class="small muted mt8">이 수량 이하가 되면 ‘부족’으로 표시됩니다. 검색어나 ‘보기’로 상품을 먼저 좁힌 뒤 적용하세요. 상품 하나만 바꾸려면 상품 이름을 눌러 상세 화면에서 바꿉니다.</p>
  <% if (q || filter) { %>
  <div class="bulk-active mt12">
    <strong class="small">사용 여부 일괄 변경</strong> <span class="small muted">— 테스트 상품 등을 정리할 때. 재고·주문 기록은 지워지지 않습니다.</span>
    <div class="actions mt8">
      <form method="post" action="/products/active-bulk" class="inline" data-confirm="현재 조건의 상품 <%= n(result.total) %>개를 사용 중지합니다. 계속할까요?">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="q" value="<%= q %>"><input type="hidden" name="filter" value="<%= filter %>"><input type="hidden" name="active" value="0">
        <button class="danger" type="submit">검색 결과 <%= n(result.total) %>개 사용 중지</button>
      </form>
      <form method="post" action="/products/active-bulk" class="inline" data-confirm="현재 조건의 상품 <%= n(result.total) %>개를 다시 사용으로 바꿉니다. 계속할까요?">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="q" value="<%= q %>"><input type="hidden" name="filter" value="<%= filter %>"><input type="hidden" name="active" value="1">
        <button type="submit">다시 사용</button>
      </form>
    </div>
  </div>
  <% } %>
</details>
<% } %>

<% if (result.rows.length === 0) { %>
  <p class="muted">조건에 맞는 상품이 없습니다.</p>
<% } else { %>
<div class="table-wrap"><table class="stack">
  <tr class="thead">
    <th>상품</th><th>바코드</th><th class="num">판매 가능</th><th class="num">보류</th><th class="num">미출고 주문</th><th class="num" title="이 수량 이하이면 ‘부족’으로 표시됩니다">안전재고</th><th>상태</th>
  </tr>
  <% result.rows.forEach(function (r) {
       var st = stockStatus({ tracked: r.tracked, qty: r.qty, safety: r.safety_stock });
       var risk = r.tracked && r.pending > r.qty; %>
  <tr<%= risk ? ' class=risk' : '' %>>
    <td class="title"><a href="/products/<%= r.id %>"><%= r.name %></a>
      <% if (r.option_name) { %><div class="small muted"><%= r.option_name %></div><% } %>
      <% if (!r.active) { %><span class="chip">사용 중지</span><% } %></td>
    <td class="small" data-label="바코드"><%= r.barcode %><div class="muted"><%= r.sku_code !== r.barcode ? r.sku_code : '' %></div><% if (!r.label_printed_at && r.active) { %><span class="chip">라벨 미출력</span><% } %></td>
    <td class="num" data-label="판매 가능"><strong><%= n(r.qty) %></strong></td>
    <td class="num" data-label="보류"><%= r.hold ? n(r.hold) : '-' %></td>
    <td class="num" data-label="미출고 주문"><%= r.pending ? n(r.pending) : '-' %><% if (risk) { %><div><span class="chip err">가용 초과</span></div><% } %></td>
    <td class="num" data-label="안전재고"><%= r.safety_stock || '-' %></td>
    <td data-label="상태"><span class="chip <%= st === 'untracked' ? '' : st %>"><%= STATUS_LABEL[st] %></span></td>
  </tr>
  <% }) %>
</table></div>
<% } %>
<%- include('partials/pager') %>
<%- include('partials/foot') %>
